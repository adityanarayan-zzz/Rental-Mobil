// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id_user  Int    @id @default(autoincrement())
  username String
  password String
  email    String @unique
  NoWA     String
}

model Mobil {
  id_mobil     Int      @id @default(autoincrement())
  nama         String
  harga        Int
  totalUnit    Int      @default(0)
  unitTersedia Int      @default(0)
  gambar       String?
  tersedia     Boolean  @default(true)
}